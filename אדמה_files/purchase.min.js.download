 que l’{{base}}, veuillez contacter votre banque ou votre société de carte de crédit.",CURRENCY_SUCCESS_STAGE_DISCLAIMER_PENDING:"Attention : Une préautorisation (blocage de fonds) a été effectuée en {{base}} pour cette transaction. Si votre compte est dans une autre devise, votre banque ou votre société de carte de crédit peut convertir le montant selon ses taux de change et ses frais. Pour toute information concernant le taux de change, les frais et le montant final dans une devise autre que {{base}}, veuillez contacter votre banque ou votre société de carte de crédit."})}]),(()=>{function b(e,t){return void 0===e?t:"false"!==e}function e(e,t){var M=this;this.spz=e,this.restrict="A",this.link=function(e,t,n){var i,a,r,o,s,c,d,l,u,p,g,m,f,h,_,A;"true"!==n.svgPanZoomDisableOnMobile&&(i=M.CheckForBoolean(n.panEnabled,!0),n.$observe("panEnabled",function(){i=M.CheckForBoolean(n.panEnabled,!0)}),_=n.panButton||"left",a=M.CheckForBoolean(n.controlIconsEnabled,!1),r=M.CheckForBoolean(n.preventMouseEventsDefault,!0),o=M.CheckForBoolean(n.zoomEnabled,!0),n.$observe("zoomEnabled",function(){o=M.CheckForBoolean(n.zoomEnabled,!0)}),s=M.CheckForBoolean(n.shiftZoomEnabled,!1),n.$observe("shiftZoomEnabled",function(){s=M.CheckForBoolean(n.shiftZoomEnabled,!1)}),c=M.CheckForBoolean(n.dblClickZoomEnabled,!0),d=n.zoomScaleSensitivity||.2,l=n.panSensitivity||1.525,u=n.minZoom||.5,p=n.maxZoom||10,g=M.CheckForBoolean(n.fit,!1),m=M.CheckForBoolean(n.contain,!0),f=M.CheckForBoolean(n.center,!0),h=n.refreshRate||"auto",_={panEnabled:i,panButton:_,controlIconsEnabled:a,preventMouseEventsDefault:r,zoomEnabled:!1,shiftZoomEnabled:s,dblClickZoomEnabled:c,zoomScaleSensitivity:d,panSensitivity:l,minZoom:u,maxZoom:p,contain:m,center:f,refreshRate:h,beforeZoom:n.beforeZoom||function(e){M.$rootScope.$broadcast("beforeZoom",e)},onZoom:n.onZoom||function(e){M.$rootScope.$broadcast("onZoom",e)},beforePan:n.beforePan||function(e){M.$rootScope.$broadcast("beforePan",e)},onPan:n.onPan||function(e){M.$r