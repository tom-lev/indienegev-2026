ate}}"><div class="svgIcon2em socialButton fbRound" ng-include="\'/images/svgIcons/facebook-round.svg\'"></div></a><a class="layout-row layout-align-center-center marginStart1em" href=https://m.me/eventertickets target=_blank aria-label="{{\'ACCESSIBILITY_CHAT_FACEBOOK\' | translate}}" ng-click=toggleFacebookChat($event)><div class="svgIcon2em socialButton fbRound" ng-include="\'/images/svgIcons/fb-messenger-round.svg\'"></div></a></div><a ng-show=isMobile class="flex-50 layout-row layout-align-end-start" href=/ title="{{\'SELLING_TICKETS\' | translate}}"><div class=eventerFullIconMedium ng-include="\'/images/svgIcons/eventerLogoFull.svg\'"></div></a></div></div></div></nav>'),e.put("/routes/partials/guestQuestionsDirective.html",'<div class=flex-100 question-name={{name}} ng-class="{\'lableMobile\': isMobile, \'control-label\': isMobile}" ng-hide="question.type == \'boolean\'"><label for={{name}} class="layout-row layout-align-start-center"><span ng-hide="question.type == \'fbProfile\' || question.type == \'igProfile\'">{{question.texts && question.texts[translateUse] || question.text}}</span> <span ng-show="question.type == \'fbProfile\'">{{\'FB_PROFILE\' | translate}}</span> <span ng-show="question.type == \'igProfile\'">{{\'INSTAGRAM_PROFILE\' | translate}} <span class=marginStart02em tooltip-html-unsafe={{igPopover}} tooltip-append-to-body=true><i class="glyphicon glyphicon-info-sign"></i> </span></span><span ng-if=question.required class="requiredQuestionNotation marginStart05em">{{\'REQUIRED_QUESTION_NOTATION\' | translate}}</span></label></div><div ng-repeat="i in answersArray track by $index" class="flex-100 layout-row layout-align-space-between-start layout-wrap animateEnterLeave"><div ng-switch=question.type class="flex-100 layout-row layout-align-start-center marginTop05em"><div ng-switch-when=select ng-class="{\'flex-100\': stretchFullWidth, \'width10em\': !stretchFullWidth}"><select rnd-id=lp_option_answers class="questionSelect form-control squareBorder" aria-atomic=true aria-live=polite ng-attr-name={{name}}_{{$index}} ng-attr-id={{name}}_{{$index}} ng-required="{{question.required && requireValidation}}" ng-model=answersArray[$index].value invalid-value-check ng-options="getChoiceValue(choice) as getChoiceText(choice) for choice in question.choices" ng-change=onOptionChanged($index)></select></div><div rnd-id=lp_choices_lst ng-switch-when=radio class=flex-100><div ng-repeat="choice in question.choices track by $index" class="flex layout-column layout-align-space-around animateEnterLeave"><div class="flex layout-row layout-align-space-around-start" ng-class="{noShow: getChoiceValue(choice) == \'invalid--value\'}"><input rnd-id=lp_choices_answers class="marginEnd05em question-radio" ng-style="getChoiceValue(choice) == answersArray[$parent.$index].value ? {{buttonStyle}} : \'\'" first-radio-btn={{name}}_{{$parent.$index}} type=radio id="{{name + \'_\' + $parent.$index}}" name="{{name + \'_\' + $parent.$index}}" role=radio ng-model=answersArray[$parent.$index].value tabindex=0 ng-value=getChoiceValue(choice) ng-change="onChoiceChanged(choice, $parent.$index)" ng-required="{{question.required && requireValidation}}" invalid-value-check> <label class="flex align-self-center" for="{{name + \'_\' + $parent.$index}}">{{getChoiceText(choice)}}</label></div></div></div><div ng-switch-when=checkbox class=flex-100><answer-check-boxes rnd-id=lp_choices_checkbox ng-model=answersArray[$index].value options={{question.choices}} name={{name}}_{{$index}} id={{name}}_{{$index}} translate-use={{translateUse}} tabindex=-1 ng-required="{{question.required  && requireValidation}}"></answer-check-boxes></div><div ng-switch-when=boolean class="flex-100 layout-row layout-align-start-center" ng-class="{\'highlight\': submitted && question.required && requireValidation && !answersArray[$index].value}"><check-box rnd-id=lp_question_boolean class="ticketCheckBox layout-align-center-center" ng-attr-name={{name}}_{{$index}} ng-attr-id={{name}}_{{$index}} ng-model=answersArray[$index].value ng-click=valueChanged() label="" ng-required="{{question.required && requireValidation}}"><span class=flex for={{name}} ng-bind-html="(question.texts && question.texts[translateUse] || question.text) | linkify" ng-class="{\'errorMessage\': submitted && question.required && requireValidation && !answersArray[$index].value}"></span> <span ng-if=question.required class="requiredQuestionNotation marginStart05em">{{\'REQUIRED_QUESTION_NOTATION\' | translate}}</span></check-box></div><div ng-switch-when=date class=questionInputWithIconContainer ng-class="{\'flex-100\': stretchFullWidth, \'width10em\': !stretchFullWidth}"><div ng-if=!isLegacy ng-click="answersArray[$index].pickerOpen = !answersArray[$index].pickerOpen" tabindex=-1><span class=questionInputIcon><ng-include class=svgIcon15em src="\'/images/svgIcons/calendar.svg\'"></ng-include></span><span><input rnd-id=lp_date_picker uib-datepicker-popup={{format}} id={{name}}_{{$parent.$index}} class="layout-row layout-align-start-center form-control squareBorder questionInputWithIcon" ng-model=answersArray[$parent.$index].value is-open=answersArray[$parent.$index].pickerOpen datepicker-options=datePickerOptions datepicker-mode="\'day\'" ng-change=valueChanged() next-text="{{\'NEXT\' | translate}}" previous-text="{{\'PREVIOUS\' | translate}}" current-text="{{\'CALENDER_TODAY\' | translate}}" clear-text="{{\'CALENDER_DELETE\' | translate}}" close-text="{{\'CALENDER_DONE\' | translate}}" datepicker-append-to-body=true ng-required="{{question.required && requireValidation}}" ng-attr-name={{name}}_{{$parent.$index}} ng-attr-id={{name}}_{{$parent.$index}} ng-class="{\'datePickerOpen\': answersArray[$parent.$index].pickerOpen}"></span></div><div ng-if=isLegacy ng-click="answersArray[$index].pickerOpen = !answersArray[$index].pickerOpen" tabindex=-1><span class=questionInputIcon><ng-include class=svgIcon13em src="\'/images/svgIcons/calendar.svg\'"></ng-include></span><span><input rnd-id=lp_date_picker datepicker-popup={{formatLegacy}} class="layout-row layout-align-start-center form-control squareBorder questionInputWithIcon questionDate" ng-model=answersArray[$parent.$index].value is-open=answersArray[$parent.$index].pickerOpen ng-change=valueChanged() datepicker-options=datePickerOptions datepicker-mode="\'day\'" datepicker-append-to-body=true current-text="{{\'CALENDER_TODAY\' | translate}}" clear-text="{{\'CALENDER_DELETE\' | translate}}" close-text="{{\'CALENDER_DONE\' | translate}}" ng-required="{{question.required && requireValidation}}" ng-attr-name={{name}}_{{$parent.$index}} ng-attr-id={{name}}_{{$parent.$index}} ng-class="{\'datePickerOpen\': answersArray[$parent.$index].pickerOpen}"></span></div></div><div ng-switch-when=location class=questionInputWithIconContainer ng-class="{\'flex-100\': stretchFullWidth, \'flex-50\': !stretchFullWidth}"><span class=questionInputIcon><ng-include ng-class="{svgIcon15em: !isLegacy, svgIcon13em: isLegacy}" src="isLegacy ? \'/images/svgIcons/mapIconPP.svg\' : \'/images/svgIcons/mapIcon.svg\'"></ng-include></span><input rnd-id=guest_location_answer googleplace ng-attr-name={{name}}_{{$index}} ng-attr-id={{name}}_{{$index}} id={{name}}_{{$index}} ng-model=answersArray[$index].value ng-change=valueChanged() ng-required="{{question.required && requireValidation}}" class="layout-row layout-align-start-center form-control squareBorder questionInputWithIcon" placeholder="{{::(\'ADDRESS\') | translate}}"></div><div ng-switch-when=salesman ng-class="{\'flex-100\': stretchFullWidth, \'flex-sm-100 flex-gt-sm-50\': !stretchFullWidth}"><select class="questionSelect form-control squareBorder" ng-attr-name={{name}}_{{$index}} aria-atomic=true aria-live=polite ng-attr-id={{name}}_{{$index}} id={{name}}_{{$index}} ng-required="{{question.required && requireValidation}}" ng-model=answersArray[$index].value ng-change=onOptionChanged($index) invalid-value-check ng-options="getChoiceText(choice) as getChoiceText(choice) for choice in question.choices"></select></div><div ng-switch-when=number ng-class="{\'flex-100\': stretchFullWidth, \'width10em\': !stretchFullWidth}"><input rnd-id=lp_question_number type=number id={{name}}_{{$index}} ng-attr-name={{name}}_{{$index}} ng-attr-id={{name}}_{{$index}} pattern=[0-9]* ng-change=valueChanged() ng-model=answersArray[$index].value class=form-control ng-required="{{question.required && requireValidation}}" ng-cut="checkPaste(question.type, $event)" ng-copy="checkPaste(question.type, $event)" ng-paste="checkPaste(question.type, $event)"></div><div ng-switch-when=image class=question-image><div class="flex-100 layout-row layout-wrap layout-align-start-start padd1"><div class="flex-100 layout-row layout-wrap"><div rnd-id=upload_guest_answer_image ngf-drop=uploadMedia($files) ng-model=answersArray[$index].value ngf-drag-over-class="\'dragover\'" class="drop-box medium portrait flex-100 layout-row layout-wrap layout-align-center-start" ngf-allow-dir=true id={{name}}_{{$index}} name={{name}}_{{$index}} tabindex=-1 ng-required="{{question.required  && requireValidation}}" accept={{defaultMimeTypes}} ngf-pattern={{defaultMimeTypes}} ng-show=!event.background ng-class="{\'with-file\': answersArray[$index].value, \'error\': submitted && question.required && requireValidation && !answersArray[$index].value}"><div class="flex-100 layout-row layout-wrap layout-align-center-center inner twoOptions" ng-class="{two: imageUploads[$index]}"><div class="flex-100 layout-row layout-wrap layout-align-center-center inner one" ng-show=!answersArray[$index].value><div ng-hide=isMobile class=flex-100><p class=font17>{{\'DRAG_PICTURE_HERE\' | translate}}</p></div><div ng-hide=isMobile class=flex-100><p class=font17>{{\'OR\' | translate}}</p></div><div class="flex-initial layout-row layout-align-center-center"><a class="btn btn btn-lg continue btn-PurchaseBlue layout-align-center-center" ng-model=imageQuestion ng-style={{buttonStyle}} ngf-select="uploadMedia($files, $invalidFile, $index)" ngf-allow-dir=true accept={{defaultMimeTypes}} ngf-pattern={{defaultMimeTypes}}>{{\'CLICK_TO_UPLOAD\' | translate }}</a></div></div><div class="flex-100 layout-row layout-wrap layout-align-center-center one positionRelative" ng-show=answersArray[$index].value><div class="flex-100 layout-row layout-wrap layout-align-center-start inner positionRelative containPhoto"><div class="flex-100 layout-align-center-center backgroundImage" ng-style="{\'background-image\': \'url(\' + answersArray[$index].value + \')\'}"></div><div class="flex-100 layout-align-center-center inner overlay-image overlay-image-bg layout-row" ng-click=openImage(answersArray[$index].value)><p class="title overlay-image-title clickable layout-align-center-center layout-row">{{\'CLICK_TO_VIEW\' | translate}}</p></div><div class="flex-100 layout-row layout-wrap layout-align-center-center actionButtons"><div class="flex-100 layout-row layout-wrap layout-align-center-center"><div class="flex-100 layout-row layout-align-center-center marginTop05em"><a class="btn btn btn-lg continue btn-PurchaseBlue layout-align-center-center" ng-style={{buttonStyle}} ng-model=answersArray[$index].value ngf-select="uploadMedia($files, $invalidFile, $index)" ngf-allow-dir=true accept={{defaultMimeTypes}} ngf-pattern={{defaultMimeTypes}}>{{\'SWITCH_IMAGE\' | translate }}</a></div><div class="flex-100 layout-row layout-align-center-center marginTop05em"><a class="btn btn btn-lg continue btn-PurchaseBlue layout-align-center-center" ng-style={{buttonStyle}} ng-click="answersArray[$index].value = undefined">{{\'RESET_IMAGE\' | translate }}</a></div></div></div></div></div><div class="flex-100 layout-row layout-wrap layout-align-center-center inner two"><eventer-loader class=bars><div class=bar></div><div class=bar></div><div class=bar></div></eventer-loader></div></div><div ngf-no-file-drop>File Drag/Drop is not supported</div></div></div></div></div><div ng-switch-when=fbProfile class="flex-100 layout-row 