 class=flex-60 style="display: table-cell">{{(event.isSupportMultiLanguage && event.producer.contactDetails.addressDescriptions && event.producer.contactDetails.addressDescriptions[translateUse]) || event.producer.contactDetails.addressDescription}} <span ng-if=event.producer.contactDetails.postalCode>, {{event.producer.contactDetails.postalCode}}</span> <span ng-if=event.producer.contactDetails.poBox>, {{\'PO_BOX\' | translate}} {{event.producer.contactDetails.poBox}}</span></div><span id=SELLER_ADDRESS class=accessibility-label>{{\'SELLER_ADDRESS\' | translate}} at {{event.producer.contactDetails.addressDescription | translate}}</span></div><div class="endTime boxDetailsItem layout-row layout-align-start-center" tabindex=0 aria-labelledby=SELLER_EMAIL><div class=flex-40><span class=bold>{{\'SELLER_EMAIL\' | translate}}:</span></div><a class=flex-60 style="display: table-cell; word-break: break-all" ng-href=mailto:{{event.producer.contactDetails.contactEmail}}>{{event.producer.contactDetails.contactEmail}}</a> <span id=SELLER_EMAIL class=accessibility-label>{{\'SELLER_EMAIL\' | translate}} at {{event.producer.contactDetails.contactEmail}}</span></div><div class="boxDetailsItem layout-row layout-align-center-center marginTop1em" ng-if="hasSocialLinks() && !isInEventerSite" tabindex=0><a class="layout-row layout-align-center-center sideMargin04em" href={{event.producer.contactDetails.youtubeLink}} target=_blank ng-show=event.producer.contactDetails.youtubeLink aria-label="{{\'ACCESSIBILITY_PRODUCER_CONTACT_YOUTUBE\' | translate}}" title="{{\'ACCESSIBILITY_PRODUCER_CONTACT_YOUTUBE\' | translate}}"><div class="layout-row layout-align-center-center socialButton youtubeRound svgIcon2em" ng-include="\'/images/svgIcons/youtube-round.svg\'"></div></a><a class="layout-row layout-align-center-center sideMargin04em" href={{event.producer.contactDetails.instagramLink}} target=_blank ng-show=event.producer.contactDetails.instagramLink aria-label="{{\'ACCESSIBILITY_PRODUCER_CONTACT_INSTAGRAM\' | translate}}" title="{{\'ACCESSIBILITY_PRODUCER_CONTACT_INSTAGRAM\' | translate}}"><div class="layout-row layout-align-center-center socialButton instagramRound svgIcon2em" ng-include="\'/images/svgIcons/instagram-round.svg\'"></div></a><a class="layout-row layout-align-center-center sideMargin04em" href={{event.producer.contactDetails.spotifyLink}} target=_blank ng-show=event.producer.contactDetails.spotifyLink aria-label="{{\'ACCESSIBILITY_PRODUCER_CONTACT_SPOTIFY\' | translate}}" title="{{\'ACCESSIBILITY_PRODUCER_CONTACT_SPOTIFY\' | translate}}"><div class="layout-row layout-align-center-center socialButton spotifyRound svgIcon2em" ng-include="\'/images/svgIcons/spotify-round.svg\'"></div></a><a class="layout-row layout-align-center-center sideMargin04em" href="{{event.producer.contactDetails.webSiteLink}}?utm=eventer" target=_blank ng-show=event.producer.contactDetails.webSiteLink aria-label="{{\'ACCESSIBILITY_PRODUCER_CONTACT_WEBSITE\' | translate}}" title="{{\'ACCESSIBILITY_PRODUCER_CONTACT_WEBSITE\' | translate}}"><div class="layout-row layout-align-center-center socialButton websiteRound svgIcon2em" ng-include="\'/images/svgIcons/website-round.svg\'"></div></a><a class="layout-row layout-align-center-center sideMargin04em" href={{event.producer.contactDetails.facebookLink}} target=_blank ng-show=event.producer.contactDetails.facebookLink aria-label="{{\'ACCESSIBILITY_PRODUCER_CONTACT_FB\' | translate}}" title="{{\'ACCESSIBILITY_PRODUCER_CONTACT_FB\' | translate}}"><div class="layout-row layout-align-center-center socialButton fbRound svgIcon2em" ng-include="\'/images/svgIcons/facebook-round.svg\'"></div></a></div></div></div></div>'),e.put("/routes/partials/puchaseArenaSVG.html",'<div id=arenaSeats class="arenaScene arenaSeatsContainer no-padd no-border" ng-class="{\'form col-xs-12 svgContainer\': !arena.heightToCollapse, heightOverride: arena.heightToCollapse}"><div class="newZoomControls innerController" ng-if="isMobile || (!arena.subArenas || !arena.subArenas.length)"><span rnd-id=arena_zoom_in_btn class="newZoomButton marginEnd05em layout-row layout-inline layout-align-center-center" ng-click=onZoomInClick()><span class="svgIcon12em layout-row layout-align-center-center" ng-include="\'/images/svgIcons/plusArenaIcon.svg\'"></span> </span><span rnd-id=arena_zoom_reset_btn class="newZoomButton layout-row layout-inline layout-align-center-center" ng-click=onZoomResetClick()><span class="svgIcon12em layout-row layout-align-center-center" ng-include="\'/images/svgIcons/refreshArenaIcon.svg\'"></span> </span><span rnd-id=arena_zoom_out_btn class="newZoomButton marginStart05em layout-row layout-inline layout-align-center-center" ng-click=onZoomOutClick()><span class="svgIcon12em layout-row layout-align-center-center" ng-include="\'/images/svgIcons/minusArenaIcon.svg\'"></span></span></div><div id=pinchCont class=arenaScene><svg class=ticketTypeSvg ng-attr-height="{{arena.height - (getHeightToCollapse() || 0)}}" ng-attr-view_box="0 {{(getHeightToCollapse() || 0)/2}} {{arena.width}} {{arena.height - (getHeightToCollapse() || 0)}}" ng-attr-width="{{arena.widthPercent || arena.width}}" ng-class="{mobile: isMobile}" svg-pan-zoom prevent-mouse-events-default={{!isMobile}} pan-button=left zoom-enabled={{isMobile}} pan-enabled="{{isMobile || (!arena.subArenas || !arena.subArenas.length)}}" shift-zoom-enabled="{{isMobile || (!arena.subArenas || !arena.subArenas.length)}}" dbl-click-zoom-enabled="{{isMobile || (!arena.subArenas || !arena.subArenas.length)}}" xmlns=http://www.w3.org/2000/svg xmlns:svg=http://www.w3.org/2000/svg><image x=0 y=0 ng-attr-width={{arena.width}} ng-attr-height={{arena.height}} xlink:href="" ng-attr-xlink:href="{{(event && event.isSupportMultiLanguage && arena.backgrounds && arena.backgrounds[translateUse]) || arena.background}}" ng-if="(event && event.isSupportMultiLanguage && arena.backgrounds && arena.backgrounds[translateUse]) || arena.background"></image><g rnd-id=section_in_arena ng-repeat="section in arena.sections" ng-hide=section.isDeleted ng-attr-transform="rotate({{section.rotate}}), translate({{section.x}}, {{section.y}})"><g ng-repeat="line in section.lines" ng-hide=line.isDeleted ng-class=seatClass(rect.id) ng-attr-transform="rotate({{line.rotate}}), translate({{line.x}}, {{line.y + ((arena.itemMarginY || 0) * ($index + 1))}})"><rect ng-repeat="rect in line.seats" ng-hide=rect.isDeleted ng-init="rect.origin = (rect.x + ((arena.itemMarginX || 0) * ($index + 1)) + arena.itemWidth * .5) + \'px \' + (rect.y + arena.itemHeight * .5) + \'px\'" ng-class=seatClass(rect.id) ng-style=placeStyle(rect) ng-click=selectSeat(rect.id) tooltip-append-to-body=true ng-attr-height={{arena.itemHeight}} ng-attr-width={{arena.itemWidth}} ng-attr-x="{{rect.x + ((arena.itemMarginX || 0) * ($index + 1))}}" ng-attr-y={{rect.y}} ng-attr-rx="{{arena.borderRadiusX != undefined ? arena.borderRadiusX : arena.itemWidth/8}}" class=svgSeat tooltip-html-unsafe={{getSeatTooltip(rect)}} uib-tooltip={{getSeatTooltip(rect)}} tooltip-placement=top tooltip-trigger=mouseenter></rect></g></g><g ng-if="arena.subArenas && arena.subArenas.length"><g rnd-id=lp_sub_arena_lst class="hoverGroup clickable svgSubArena" ng-repeat="subArena in arena.subArenas" ng-hide=subArena.isDeleted ng-disabled=subArena.isDisabled ng-click="!subArena.isDisabled && selectArena(subArena.arenaId)"><path uib-tooltip={{subArenaTooltipText(subArena)}} tooltip={{subArenaTooltipText(subArena)}} tooltip-placement=top tooltip-append-to-body=true tooltip-trigger=mouseenter ng-attr-fill="{{::subArena.fill || \'#868CDB\'}}" ng-attr-d={{::subArena.path}}></path></g></g><g ng-if="arena.areas && arena.areas.length"><g class="hoverGroup clickable svgArea" ng-repeat="area in arena.areas" ng-hide="area.isDeleted || areaHasDuplicateAreasWithTicketTypes(arena.areas, area)" ng-disabled="!hasTicketTypes(\'areas\', area.areaId || area._id)" ng-click="hasTicketTypes(\'areas\', area.areaId || area._id) && chooseArea(area, $event)"><path ng-attr-d={{::area.path}} ng-attr-fill="{{hoveredTicketType && hoveredTicketType.areas.indexOf(area.areaId || area._id) != -1 ? hoveredTicketType.seatColor : area.fill || \'#868CDB\'}}" ng-class="{hovered: hoveredTicketType && hoveredTicketType.areas.indexOf(area.areaId || area._id) != -1}" uib-tooltip="{{areaPopoverText(\'areas\', area.areaId || area._id, area)}}" tooltip="{{areaPopoverText(\'areas\', area.areaId || area._id, area)}}" tooltip-placement=top tooltip-append-to-body=true tooltip-trigger=mouseenter></path></g></g></svg></div></div>')}]);