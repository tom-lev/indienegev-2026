                                    $(".check-dark input").prop('checked', false);
                                    dark = 1;
                                }
                            });
                            var bright = 1;
                            $('.VA-bright-btn').click(function () {
                                if (bright == 1) {
                                    eraseCookie('VA_dark');
                                    eraseCookie('VA_grayscale');
