                            /*****************/
                            /**set Attribute**/
                            /*****************/
                           
			   

                            function ScreenReaderAdapt() {
                                SetTabindex();
								  
                                $('i,hr,br').attr('aria-hidden', 'true');
                                $('input[required]').attr({ 'aria-required': 'true', 'aria-invalid': 'false' });
                                $('img').each(function () {
                                    if ($(this).attr('alt') == undefined) {
                                        $(this).attr('alt', '');
                                    }
                                });
								
								
								





                            }


                            // Hide and remote accessibility in iframe#distributeFrame
                            //
                            var updateIframeAccessibilityTimeout = null;

                            function updateIframeAccessibility() {
				var ids = ['distributeFrame','experience-purchase-page'];
                                var frames = window.frames || window.document.frames;

				for(var k=0;k<ids.length; k++) {
		                        var frame = frames[ids[k]];
		                        if(frame) {
		                            var jIframe = $(frame);

		                            // Wait for acccessibility to load:
		                            if(jIframe.contents().find('#menuAccessibility').length >= 1) {
	   
		                                updateIframeAccessibilityTimeout = null;
		
		                                jIframe.contents().find('#VAopenMenu').hide();
		
		                                var ownCheckboxes = $('#menuAccessibility input[type="checkbox"]').toArray();
		                                var iframeCheckboxes = jIframe.contents().find('#menuAccessibility input[type="checkbox"]').toArray();
		
		                                for(var i = 0; i < ownCheckboxes.length; i++) {
		                                    var own = $(ownCheckboxes[i]);
		                                    var remote = $(iframeCheckboxes[i]);
		                                    if(own.prop('checked') != remote.prop('checked')) {
		                                        console.log({index: i, own: own.prop('checked'), remote: remote.prop('checked')});
		                                        remote.click();
		                                        updateIframeAccessibilityTimeout = setTimeout(updateIframeAccessibility, 100);
		                                        return;
		                                    }
		                                }
		                            }
		                        }
				}

                                updateIframeAccessibilityTimeout = setTimeout(updateIframeAccessibility, 500);
                            }

                            updateIframeAccessibility();

                            $('#menuAccessibility input[type="checkbox"]').on('click',function(){
                                if(updateIframeAccessibilityTimeout !== null) {
                                    clearTimeout(updateIframeAccessibilityTimeout);
                                    updateIframeAccessibilityTimeout = setTimeout(updateIframeAccessibility, 100);
                                }
                            });

			    
                        }
                    }, 3000);

                }


            }, 4000);
});
})();