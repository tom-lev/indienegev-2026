                                        var jCalendarInput = $.vaOnce('btn147.3', '.ta-daterangepicker .calendar > .input');
                                        jCalendarInput.each(function(){
                                            var jThis = $(this);
                                            var jOldInput = jThis.find('input');
                                            jOldInput.removeAttr("tabindex").hide();
                                            var jNewInput = $('<input class="input-mini" type="date" tabindex="0" aria-label="יש להזין תאריך בפורמט dd/mm/yyyy">');                                         
                                            jThis.prepend(jNewInput);
                                            jNewInput.on('input', function(){
                                                jOldInput.val(jNewInput.val());
                                                jOldInput.get(0).dispatchEvent(new Event('change', { 'bubbles': true }));
                                            });
                                            jThis.parent().find('.calendar-table').hide();
                                            val = jOldInput.val().split('-');
                                            if(val.length == 3) {
                                                jNewInput.val(val[2]+'-'+val[1]+'-'+val['0']);
                                            }
                                            jNewInput.trigger('input');
                                        });

