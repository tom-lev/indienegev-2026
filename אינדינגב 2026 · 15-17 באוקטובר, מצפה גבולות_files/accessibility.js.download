                                        $(this).attr("style", "");

                                    });

                            });
                            if (VA_Accessibility) {
                                if (VA_dark) {
                                    $('body')
                                        .removeClass('VA-bright')
                                        .removeClass('VA-grayscale')
                                        .addClass('VA-dark');
                                    $('#menuAccessibility *,#section_four_icon *').addClass('VA');
                                    $(".check-grayscale input").prop('checked', false);
                                    $(".check-bright  input").prop('checked', false);
