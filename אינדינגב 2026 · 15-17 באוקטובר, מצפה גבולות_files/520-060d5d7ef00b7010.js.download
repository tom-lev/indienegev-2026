"use strict";(self.webpackChunk_N_E=self.webpackChunk_N_E||[]).push([[520],{7267:function(a,e,t){t.d(e,{E:function(){return d}});let d=[{id:"ad-1-1140",name:"פאנל פתיחה - החזרה לחיים באשכול - איך זה נראה?",day:1,stage:"adama",start:1140,end:1200,scheduleOnly:!0},{id:"ad-1-1200",name:"אם זה נגמר",day:1,stage:"adama",start:1200,end:1320,scheduleOnly:!0,tag:"סרט",series:"קולנוע דרום מציג",lead:"סרט ושיחת יוצרות עם העורכת נילי פלר והבמאית שרון לוזון",about:'דרך יומניה האישיים וקטעי ארכיון נדירים, הסרט מביא את סיפורה המרגש והטרגי של ענבל פרלמוטר, סולנית להקת "המכשפות" ודמות אייקונית בקאנון הישראלי ופורצת דרך במוזיקה האלטרנטיבית המקומית.'},{id:"ad-1-1320",name:"המבריחים",day:1,stage:"adama",start:1320,end:1410,scheduleOnly:!0,tag:"סרט",lead:"במאים טוני קופטי ויניב ברמן",about:'מישל אלרהב, בעל חנות ספרים וקפה ביפו, מבקש מאחיינו, מפיק הסרטים טוני קופטי, להיכנס איתו לשותפות בעסק, ועל הדרך חושף אותו לבעיית הספרים בשפה הערבית בארץ. ההרפתקה המשותפת, שמתחילה בקשיי יבוא של ספרים בערבית מהארץ והעולם, הופכת למסע חניכה בין-דורי וקומי שבמהלכו טוני מתפכח ויוצא לחקור מה קורה עם לימודי השפה הערבית הספרותית במערכת החינוך הישראלית ולאן נעלמו הספרים שהיו ביפו לפני 1948. "המבריחים" מבקש לפקוח את עינינו לדיכוי המתמשך של השפה והתרבות הפלסטינית, ולהביא לשינוי אמיתי בחקיקה ובחינוך.'},{id:"ad-1-1410",name:"חולה את נתן",day:1,stage:"adama",start:1410,end:1470,scheduleOnly:!0,tag:"סרט",series:"קולנוע דרום מציג",lead:"במאי רובי אלמליח",about:"סיפורם הקומי-טרגי של האחים חולה ונתן, שני מוסכניקים מפאתי שדרות. כאשר ברקע המצב בין ישראל לעזה מידרדר וטילי קסאם נופלים סביבם, המוסך – מקור פרנסתם היחיד – נמצא בסכנת סגירה. בהומור גרוטסקי, בצל האיום המתמשך על חייהם ועבודתם, השניים מנסים לשרוד."},{id:"ad-1-1470",name:"קולנוע שבלולים",day:1,stage:"adama",start:1470,end:1560,scheduleOnly:!0,about:"מיטב הקולנוע העצמאי המקומי ימלא את הלילה בהזיות מהלב ופיקסלים צבעוניים"},{id:"ad-2-510",name:"יוגה בוקר עם דנה",day:2,stage:"adama",start:510,end:600,scheduleOnly:!0,lead:"תרגול יוגה ויניאסה רכה (תביאו מזרנים)"},{id:"ad-2-600",name:"מפגש כתיבה",day:2,stage:"adama",start:600,end:720,scheduleOnly:!0,lead:"עם אורי לנקינסקי, המייסדת של Creative Writing",about:'מפגש כתיבה בעקבות תפיסת "האחר" של הפילוסוף עמנואל לוינס.'},{id:"ad-2-720",name:"עם הפנים אל האחר",day:2,stage:"adama",start:720,end:840,scheduleOnly:!0,lead:"פאנל בהנחיית סער גמזו, ובהשתתפות אורית טשומה, נועם ענבר ואורי גינוסר",about:"חיים ויצירה מתוך עמדה של אמפתיה, בהשראת האלבום 'האחר' של ברי סחרוף."},{id:"ad-2-840",name:"שעת סיפור ילדים",day:2,stage:"adama",start:840,end:930,scheduleOnly:!0,lead:"עם יובל מנדלסון"},{id:"ad-2-930",name:"תודעה של בחירה",day:2,stage:"adama",start:930,end:1020,scheduleOnly:!0,lead:"אריאל קלצ'קין בשיחה פתוחה עם אלי ביתאן, עדי סקוטק וקוסטה קפלן",about:"על איך חיים ופועלים בישראל כיום."},{id:"ad-2-1020",name:"אטלס הלבנט",day:2,stage:"adama",start:1020,end:1140,scheduleOnly:!0,lead:"אלעד שפינדל",about:"קריאה אלטרנטיבית של מרחב הגבול בין ישראל ולבנון. דרך מיפויים של היסטוריות, סיפורים ומרחבים שהתקיימו או יכלו להתקיים - עולות אפשרויות חדשות לחיים במרחב הלבנטיני."},{id:"ad-2-1140",name:"קלרה הקדושה",day:2,stage:"adama",start:1140,end:1260,scheduleOnly:!0,tag:"סרט",series:"קולנוע דרום מציג",lead:"סרט ושיחת יוצרים עם הבמאים ארי פולמן ואורי סיוון",about:"לקראת המילניום שמביא את האנושות לסף אנדרלמוסיה, בעיירת פיתוח, שם נערה צעירה בשם קלרה זוכה לכוחות על-טבעיים שגורמים למהומות והתרחשויות בקרב סביבת העיירה, חבריה הפרועים של קלרה, מוריה המשונים, אנשי העיירה ומשפחתה של קלרה."},{id:"ad-2-1260",name:"מהאדמה",day:2,stage:"adama",start:1260,end:1320,scheduleOnly:!0,tag:"הקרנה",lead:"שני פרקים מתוך הסדרה בבימויו של שאדי סרור - הפרק ענבים והפרק זיתים",about:"מטבח מקומי הוא הרבה מעבר למזון - הוא ביטוי חי לזהות, לזכרונות ולמורשת. חומרי הגלם מבטאים את הגיאוגרפיה שלו ואת עונות השנה, את הקונפליקטים והפוליטיקה. המטבח הפלסטיני הוא מרכיב חשוב בהיסטוריה העממית, האישית והנשית; הוא מתכתב עם ההיסטוריה שבספרים, מוסיף לה טעם וריח, ומעיר אותה לחיים.\nהטבחית המחוננת מוזנא בשארה יוצאת למסע בן שמונה פרקים, שהוא גם מסע אל דור הולך ונעלם של נשים הנושאות את זכרון הבישול הכפרי. כל פרק עוסק בחומר גלם, באזור הגידול ובעונה שלו: הזית והסומאק, העכוב והחצילים הם היסודות שמהם נוצר טעמה של הארץ, סיפורים שמוזנא מבקשת לחקור, ואלטרנטיבה לאורח החיים המתועש של ימינו."},{id:"ad-2-1320",name:"מקבץ סרטי גמר",day:2,stage:"adama",start:1320,end:1440,scheduleOnly:!0,series:"קולנוע דרום מציג",items:[{title:"סקיצה",credit:"שחר איצקין",text:"בין ספות ונסיעות, יקי הצייר הבלתי מוכשר מחפש את עצמו ואיפה להעביר את הזמן."},{title:"משתדלת",credit:"נועה אלישע",text:"קומדיית התבגרות על בחורה בת 30 במפגש נוט-סו-ריאליסטי עם המציאות."},{title:"אהבה לנצח",credit:"הילה מנור",text:"בדירה קטנה בחיפה, שגרת חייהם השקטה של זוג מבוגר מתגלה כדיוקן עדין של אהבה, שינוי וחלוף הזמן."},{title:"נופל למעלה",credit:"עמית ללוש",text:"רדוף טראומה, רמי מוצא נחמה מעוותת במלון יוקרה אליו פונה. כשהחזרה למציאות הופכת לבלתי נמנעת, ניסיונו להיאחז בקרנות המזבח, הופך למאבק קיומי על חייו החדשים"},{title:"מתגלגלים",credit:"טוני דנילצ'נקו ושחר לוני",text:"טוני, דניס ודרינה, שלושה תיכוניסטים עולי ברית המועצות לשעבר, נפגשים מאחורי שיחי הפנימיה ביום חלוקת דמי הכיס כדי לחלוק שאריות סיגריה, רגע לפני שהם מתפצלים למסע מוזיקלי בדרך להגשים חלום."},{title:"מלך קיפוד",credit:"אופיר טל",text:"עבור אסי נגמרו החיים לאחר שאיבד את אשתו בתאונת דרכים. כשהוא נדרש לעשות בייביסיטר לאחיינית בת השש שלו, אין לו ברירה אלא לקום מהספה ולחזור לתחביב הישן שלהם - לעשות סרטים."}]},{id:"ad-2-1440",name:"קולנוע שבלולים",day:2,stage:"adama",start:1440,end:1530,scheduleOnly:!0,about:"מיטב הקולנוע העצמאי המקומי ימלא את הלילה בהזיות מהלב ופיקסלים צבעוניים"},{id:"ad-3-510",name:"יוגה בוקר עם דנה",day:3,stage:"adama",start:510,end:600,scheduleOnly:!0,lead:"תרגול יוגה ויניאסה רכה (תביאו מזרנים)"},{id:"ad-3-600",name:"שעת סיפור ילדים",day:3,stage:"adama",start:600,end:660,scheduleOnly:!0},{id:"ad-3-660",name:"למי הכפיים?",day:3,stage:"adama",start:660,end:750,scheduleOnly:!0,lead:"עם ג׳נט בלאי, כרמן אלמקייס עמוס ואיתמר שלמה כהן בהנחיית מיטל אבוקסיס",about:"על המרחב שבין יצירה וסולידריות."},{id:"ad-3-750",name:"הופעה מהגיהנום - פודקאסט לייב",day:3,stage:"adama",start:750,end:840,scheduleOnly:!0,lead:"אורי רונן מארח את רוני בר הדס",about:"הפודקאסט האהוב 'הופעה מהגיהנום' מגיע בפעם הראשונה לאינדינגב!\nאורי רונן, מגיש הפודקאסט מארח את הזמרת והיוצרת רוני בר הדס, ממש אחרי ההופעה שלה בפסטיבל שהכל עוד חם וטרי.\nהפרק יצולם ויוקלט מול קהל חי, באווירה כיפית, זורמת ובלתי צפויה כמו שרק הופעה מהגיהנום יודעים להביא: סיפורים מצחיקים, הופעות גרועות ונוראיות, שיחות על מוזיקה והחיים עצמם."}]},2363:function(a,e,t){t.d(e,{$:function(){return s}});var d=t(7267);let n=a=>"adama"===a.stage,s=[...[{id:"e0",name:"אתי רומנו",day:1,stage:"kof",start:1080,end:1120},{id:"e1",name:"L.D & SONS",day:1,stage:"soundsystem",start:1080,end:1170},{id:"e2",name:"ניר כנען",day:1,stage:"kof",start:1140,end:1180},{id:"e3",name:"AVIV SIEGAL",day:1,stage:"inditronics",start:1140,end:1290,tag:"SPACE JAM TAKEOVER"},{id:"e4",name:"פאנל פתיחה - איך החיים עכשיו בעוטף?",day:1,stage:"adama",start:1140,end:1230,scheduleOnly:!0},{id:"e5",name:"עולמי",day:1,stage:"pil",start:1170,end:1210},{id:"e6",name:"JonJon",day:1,stage:"soundsystem",start:1170,end:1290},{id:"e7",name:"אסולין",day:1,stage:"kof",start:1200,end:1240},{id:"e8",name:"ALLAN TUNE",day:1,stage:"pil",start:1230,end:1270},{id:"e9",name:"סרט אלבי",day:1,stage:"adama",start:1230,end:1320,scheduleOnly:!0},{id:"e10",name:"תמיר בר",day:1,stage:"kof",start:1260,end:1300},{id:"e11",name:"LIOR SHNEOR",day:1,stage:"inditronics",start:1290,end:1410,tag:"SPACE JAM TAKEOVER"},{id:"e136",name:"המחלקה",day:1,stage:"raket",start:1200,end:1240,scheduleOnly:!0},{id:"e12",name:"עמליה סמול",day:1,stage:"raket",start:1260,end:1300,scheduleOnly:!0},{id:"e13",name:"עמר גשן",day:1,stage:"pil",start:1290,end:1330},{id:"e14",name:"ADI BAREKET",day:1,stage:"soundsystem",start:1290,end:1410},{id:"e15",name:"אהוד בנאי, בנו הנדלר ופליטי הדאב",day:1,stage:"kof",start:1320,end:1375},{id:"e16",name:"אייל יונתי וצלילי הנכס",day:1,stage:"raket",start:1320,end:1360},{id:"e17",name:"קולנוע דר